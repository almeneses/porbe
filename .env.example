PORBE_WEB_PORT=3000
PORBE_API_PORT=8080
PORBE_DB_PORT=5432

POSTGRES_DB=porbe
POSTGRES_USER=porbe
POSTGRES_PASSWORD=porbe_local

APP_SECURITY_ADMIN_USERNAME=admin
APP_SECURITY_ADMIN_PASSWORD=admin
APP_SESSION_COOKIE_SECURE=false

# Proveedor de precios
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
YAHOO_FINANCE_USER_AGENT=Porbe/0.1
YAHOO_FINANCE_CONNECT_TIMEOUT_SECONDS=5
YAHOO_FINANCE_READ_TIMEOUT_SECONDS=15

# Informe semanal (viernes 5:30 p. m. hora Colombia)
PORTFOLIO_REPORT_WEEKLY_ENABLED=true
PORTFOLIO_REPORT_WEEKLY_CRON="0 30 17 * * FRI"
PORTFOLIO_REPORT_TIMEZONE=America/Bogota

# Opcional fuera de Docker, por ejemplo /usr/bin/chromium
PORTFOLIO_REPORT_BROWSER_EXECUTABLE=

# Tiempo máximo para generar el comentario con Codex.
CODEX_TIMEOUT_SECONDS=120
AI_MODEL=
AI_EFFORT=

# WhatsApp Web temporal (servicio Node interno, no es la API oficial de Meta)
WHATSAPP_ENABLED=true
WHATSAPP_INTERNAL_TOKEN=porbe_whatsapp_local
# Número internacional sin + para los envíos automáticos, por ejemplo 573001234567
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_CONNECT_TIMEOUT_SECONDS=3
WHATSAPP_READ_TIMEOUT_SECONDS=45
